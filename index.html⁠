// 4. Instant Zero-Lag Fallback Engine
function fallbackResponse(input) {
  const clean = input.toLowerCase().trim();
  
  if (/^(hi|hello|yo|hey|sup)/.test(clean)) {
    appendMsg("Yo! Nexus is fully live and listening. What are we building or running today?", "ai");
  } else if (clean.includes("minecraft") || clean.includes("nether")) {
    appendMsg("Nexus Protocol: Minecraft data loaded. Better prep your fire resistance before hitting those Nether fortress corridors!", "ai");
  } else if (clean.includes("geometry dash") || clean.includes("gd")) {
    appendMsg("Nexus Protocol: Levels fully synchronized. Getting massive comment likes takes serious rhythm. Keep grinding!", "ai");
  } else {
    appendMsg(`Nexus Core: Connection stable. I'm processing your prompt about "${input}". Let's take the next steps on this dashboard build!`, "ai");
  }
}

function handleInput() {
  const text = userInput.value.trim();
  if (!text) return;
  
  appendMsg(text, "user");
  userInput.value = "";
  
  const loadingElement = appendMsg("Nexus is processing request...", "system");
  fetchResponse(text, loadingElement);
}

sendBtn.addEventListener("click", handleInput);
userInput.addEventListener("keypress", (e) => {
  if (e.key === "Enter") handleInput();
});
